# Copy to backend/.env and fill in what you have. Everything is optional for Milestone 1.

# Database (defaults to the docker-compose Postgres)
# RAG_DATABASE__URL=postgresql+psycopg://rag:rag@localhost:5433/rag

# Langfuse Cloud (free Hobby tier): https://cloud.langfuse.com → Project → API keys
# Tracing is switched on automatically when both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# LangSmith (free Developer plan): auto-traces LangChain / LangGraph when enabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-pipeline

# Groq (used from Milestone 4 as the eval judge)
GROQ_API_KEY=

# Gemini
GEMINI_API_KEY=